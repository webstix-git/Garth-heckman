# Copy to .env.local and fill from Supabase → Project Settings → API

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Server-only secret (or legacy service_role JWT)
SUPABASE_SECRET_KEY=sb_secret_xxx
# SUPABASE_SERVICE_ROLE_KEY=

# Store management — real Supabase Auth (email/password)
# Create this user in Supabase Dashboard → Authentication → Users → Add user
# Then list the same email here so only that account can open /dashboard
AUTH_ADMIN_EMAIL=admin@example.com
AUTH_ADMIN_EMAILS=admin@example.com
AUTH_ADMIN_NAME=Store Administrator

# Absolute origin for PayPal return URLs (required in production)
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3001
# Absolute origin for server-side catalog fetch (same process)
STOREFRONT_URL=http://127.0.0.1:3001

# Which store this website uses (from admin Developers → Store ID)
NEXT_PUBLIC_STORE_ID=0001

# Ecommerce backend — server-only (do NOT use NEXT_PUBLIC_ for the key)
BACKEND_URL=http://127.0.0.1:3001
STORE_API_KEY=pk_live_...
# Same backend origin used by the admin multi-zone proxy. In production this
# should point to the deployed backend; in local development use port 3001.
ADMIN_BACKEND_URL=http://127.0.0.1:3001
# Optional alias if you prefer STORE_ID server-side only:
# STORE_ID=0001

# PayPal Checkout (Orders v2) — sandbox or live
# Dashboard: https://developer.paypal.com/dashboard/applications
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox | live
PAYPAL_MODE=sandbox

# Optional: skip PayPal / sample checkout
# NEXT_PUBLIC_SAMPLE_CHECKOUT=1
# SAMPLE_CHECKOUT=1

# Printify
# PRINTIFY_API_TOKEN=
# PRINTIFY_SHOP_ID=
