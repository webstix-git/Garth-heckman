# Copy to .env.local.

# Customer sign-in uses the SAME Supabase project as the ecommerce backend
# (backend NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY).
# Customer and order data are read through the backend, so no secret key is needed here.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_BACKEND_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Store management — real Supabase Auth (email/password)
# Create the user in Supabase Dashboard → Authentication → Users → Add user,
# then assign an active row in public.store_memberships for admin access.
AUTH_ADMIN_NAME=Store Administrator

# Shared server-only session secret. Use the same variable name in the backend.
AUTH_SESSION_SECRET=generate-a-long-random-secret

# Absolute origin for PayPal return URLs (required in production)
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3001
# Absolute origin for server-side catalog fetch (same process)
STOREFRONT_URL=http://127.0.0.1:3001

# Ecommerce backend — server-only (do NOT use NEXT_PUBLIC_ for the key).
# The store key decides which store this website is; no store ID is needed.
BACKEND_URL=http://127.0.0.1:3001
STORE_API_KEY=pk_live_...
# Same backend origin used by the admin multi-zone proxy. In production this
# should point to the deployed backend; in local development use port 3001.
ADMIN_BACKEND_URL=http://127.0.0.1:3001
# PayPal Checkout (Orders v2) — sandbox or live
# Dashboard: https://developer.paypal.com/dashboard/applications
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox | live
PAYPAL_MODE=sandbox

# Optional: skip PayPal / sample checkout
# NEXT_PUBLIC_SAMPLE_CHECKOUT=1
# SAMPLE_CHECKOUT=1

# Printify
# PRINTIFY_API_TOKEN=
# PRINTIFY_SHOP_ID=
